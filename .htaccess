# Interne Notizen niemals öffentlich ausliefern. Sie liegen im DocumentRoot,
# weil sie dort entstehen und dort gebraucht werden – ein Angebot sind sie
# nicht.
#
# RISIKEN-TODO.md und SPIELE-IDEEN.md sind ausserdem per .gitignore vom
# Seitenrahmen-Repo ausgeschlossen, diese Sperre ist dort die zweite Reihe.
# CLAUDE.md ist umgekehrt bewusst im Repo (sie beschreibt genau diesen
# Seitenrahmen), gehoert aber trotzdem nicht ins Netz: sie nennt Serverpfade
# und verweist auf die Risikoliste – wer sie liest, weiss, wonach er suchen
# muesste.
<FilesMatch "^(RISIKEN-TODO|SPIELE-IDEEN|OFFEN-NACHZIEHEN|CLAUDE|INSTAGRAM|PRUEFPLAN)\.md$">
    Require all denied
</FilesMatch>

# Werkzeuge und die gemeinsamen Vorlagen sind Quelltext, kein Angebot. Sie
# liegen nur im DocumentRoot, damit sie mit dem Seitenrahmen versioniert
# werden. /gemeinsam/ wird von keiner Seite geladen – die Spiele haben ihre
# eigene Kopie, genau darum geht es dort.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule "^(werkzeug|gemeinsam|doku)(/|$)" - [F,L]
</IfModule>

# spiele.json nennt Ports und Dienstnamen. Die Dienste hoeren nur auf
# 127.0.0.1, aber eine fertige Landkarte muss man trotzdem nicht ausliefern.
<FilesMatch "^spiele\.json$">
    Require all denied
</FilesMatch>

# Die Hochzeitsseite laeuft als eigener Dienst; Apache reicht /hochzeit/
# vollstaendig an ihn weiter und kommt normalerweise gar nicht ans
# Dateisystem. Diese Regel ist die zweite Reihe fuer den Fall, dass der
# Apache-Block einmal fehlt: dann liegen dort Originalbilder, das Gaestebuch
# und die Zugangswoerter offen im DocumentRoot.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule "^hochzeit/(daten|medien|pakete)(/|$)" - [F,L]
</IfModule>

# Versionsverwaltung sperren. Seit hier ein Repo liegt, wuerde Apache
# /.git/ sonst ganz normal als Verzeichnis ausliefern – und damit die
# komplette Historie inklusive geloeschter Dateien.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule "(^|/)\.git(/|$)" - [F,L]
</IfModule>

# Ebenso die Git-Hilfsdateien, falls mod_rewrite mal fehlt.
<FilesMatch "^\.(git|gitignore|gitattributes|gitmodules)$">
    Require all denied
</FilesMatch>
